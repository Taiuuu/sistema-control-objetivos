# =============================================================================
# VESP Organizations - Variables de Entorno
# Copiá este archivo como .env y completá con valores propios.
# =============================================================================

# SEGURIDAD (OBLIGATORIAS en producción)
VESP_JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_LARGO_Y_ALEATORIO
VESP_ENCRYPTION_KEY=REEMPLAZAR_CON_CLAVE_DE_CIFRADO_LARGA_Y_ALEATORIA

# API local embebida (opcional; si se define, exige header X-API-Key)
# VESP_API_KEY=clave-local-opcional

# Sincronización con servidor remoto (desactivado por defecto; sin hosting aún)
# VESP_SYNC_REMOTO=0

# BASE DE DATOS (opcional)
# VESP_DB_PATH=C:/ruta/personalizada/seguridad.db

# API Flask independiente (opcional)
# VESP_API_HOST=127.0.0.1
# VESP_API_PORT=5000
# VESP_API_DEBUG=false

# LOGGING (opcional)
# VESP_LOG_LEVEL=INFO
